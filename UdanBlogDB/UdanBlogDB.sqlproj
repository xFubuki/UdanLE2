<Project Sdk="MSBuild.Sdk.SqlProj/3.2.0">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SqlServerVersion>Sql160</SqlServerVersion>
    <DacpacName>UdanBlogDB</DacpacName>
    <RootNamespace>UdanBlogDB</RootNamespace>
    <Name>UdanBlogDB</Name>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="dbo\Tables\Users.sql" />
    <Content Include="dbo\Tables\Posts.sql" />
  </ItemGroup>
</Project>
